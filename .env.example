# Copiá este archivo como .env.local para desarrollo. En producción, cargalas en Vercel.

# URL pública del sitio (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://a-mordidas-sandwicheria.vercel.app

# Panel de administrador (/admin). Sin estas dos, el panel queda apagado y se usan los precios de src/data/products.ts.
# Solo la clave PUBLICABLE (sb_publishable_…). NUNCA la secreta (service_role / sb_secret_…).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Protege la tarea diaria /api/keepalive (Vercel la envía sola si está cargada).
CRON_SECRET=
